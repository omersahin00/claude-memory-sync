{
  "name": "claude-memory-sync",
  "productName": "Claude Memory Sync",
  "version": "2.7.4",
  "description": "Moves, two-way syncs and backs up Claude Code memories, VSCode workspace files and Claude settings between devices.",
  "main": "app/main.js",
  "bin": {
    "claude-memory-sync": "cli.js"
  },
  "scripts": {
    "core": "node scripts/sync-core.js",
    "restic": "node scripts/fetch-restic.js",
    "dev": "node scripts/fetch-restic.js && node scripts/dev.mjs",
    "build": "vite build",
    "start": "node scripts/fetch-restic.js && vite build && electron .",
    "pretest": "node scripts/fetch-restic.js",
    "test": "node --test",
    "icons": "node scripts/make-icons.js",
    "dist:mac": "node scripts/fetch-restic.js mac && vite build && electron-builder --mac --publish never && node scripts/collect-release.js mac",
    "dist:win": "node scripts/fetch-restic.js win && vite build && electron-builder --win --publish never && node scripts/collect-release.js win"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "lucide-react": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "com.omersahin.claude-memory-sync",
    "productName": "Claude Memory Sync",
    "copyright": "Copyright © 2026 omersahin00",
    "directories": {
      "output": "dist/electron",
      "buildResources": "build"
    },
    "files": [
      "app/*.js",
      "app/locales/*.json",
      "lib/**/*",
      "core/**/*",
      "dist/renderer/**/*",
      "build/tray*.png",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "vendor/restic/${os}-${arch}",
        "to": "restic",
        "filter": [
          "restic",
          "restic.exe"
        ]
      },
      {
        "from": "vendor/restic/LICENSE",
        "to": "restic/LICENSE"
      },
      {
        "from": "licenses/restic-third-party.txt",
        "to": "restic/THIRD-PARTY-NOTICES.txt"
      }
    ],
    "fileAssociations": [
      {
        "ext": "memsync",
        "name": "Claude Memory Bundle",
        "description": "Claude Memory Sync bundle",
        "role": "Editor",
        "icon": "memsync"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "Claude-Memory-Sync-macOS-${arch}-${version}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Claude-Memory-Sync-Windows-Setup-${version}.${ext}"
    }
  }
}
