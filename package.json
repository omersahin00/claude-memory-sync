{
  "name": "claude-memory-sync",
  "productName": "Claude Memory Sync",
  "version": "2.2.0",
  "description": "Moves, two-way syncs and backs up Claude Code memories, VSCode workspace files and Claude settings between devices.",
  "main": "app/main.js",
  "bin": { "claude-memory-sync": "cli.js" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "node --test",
    "icons": "node scripts/make-icons.js",
    "dist:mac": "vite build && electron-builder --mac --publish never && node scripts/collect-release.js mac",
    "dist:win": "vite build && electron-builder --win --publish never && node scripts/collect-release.js win"
  },
  "engines": { "node": ">=22.12.0" },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "lucide-react": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "com.omersahin.claude-memory-sync",
    "productName": "Claude Memory Sync",
    "directories": { "output": "dist/electron", "buildResources": "build" },
    "files": ["app/*.js", "app/locales/*.json", "lib/**/*", "dist/renderer/**/*", "build/tray*.png", "package.json"],
    "fileAssociations": [
      { "ext": "memsync", "name": "Claude Memory Bundle", "description": "Claude Memory Sync bundle", "role": "Editor" }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ]
    },
    "dmg": { "artifactName": "Claude-Memory-Sync-${version}-${arch}.${ext}" },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "artifactName": "Claude-Memory-Sync-Setup-${version}.${ext}" }
  }
}
